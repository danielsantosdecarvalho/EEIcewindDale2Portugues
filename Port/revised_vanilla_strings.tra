@122143=~Palavra de Poder, Atordoar~
@122144=~Palavra de Poder, Cego~
@122145=~Símbolo do Medo~
@122146=~Símbolo, Dor~
@122147=~Cavaleiro Demônio~
@122148=~Cavaleiro Demônio~
