@100291=~Você ganha experiência por completar a missão estúpida de Testículos~
@100292=~Não, mas você sabe alguma coisa sobre a mulher que vive no deserto oriental?~
@100293=~Você ganha experiência por fazer Testículos sofrer e esperar~
@100294=~Você ganha experiência por irritar Testículos permanentemente~
@100295=~Você ganha experiência por sobreviver à canção de Testículos~
@100296=~Você ganha experiência por completar a missão estúpida de Testículos quest~
@100297=~Não, mas há alguma pista sobre as crianças desaparecidas?~
@100298=~Você ganha experiência por fazer testículos sofrerem e esperarem~
@100299=~Você ganha experiência por irritar testículos permanentemente~
